# Account mode with the real sign-in path, against the stand-in provider that
# `npm run dev:api:sign-in` starts. With a real provider these two settings
# are its address and the client id it gives Finken (docs/SIGN-IN.md).
VITE_API_URL=/api
VITE_AUTH_ISSUER=http://127.0.0.1:4400
VITE_AUTH_CLIENT_ID=finken-web
