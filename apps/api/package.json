{
  "name": "@finken/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import tsx src/server.ts",
    "start": "node dist/server.js",
    "db:migrate": "node --env-file-if-exists=.env --import tsx src/migrate.ts",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev:memory": "node --import tsx scripts/dev-memory.ts",
    "db:reconcile": "node --env-file-if-exists=.env --import tsx src/reconcile.ts",
    "db:restore-check": "node --env-file-if-exists=.env --import tsx src/restore.ts",
    "beta": "node --env-file-if-exists=.env --import tsx src/beta.ts"
  },
  "dependencies": {
    "@finken/domain": "*",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "postgres": "^4.1.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@types/node": "^24.0.0",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
