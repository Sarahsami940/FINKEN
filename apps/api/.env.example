# Copy to apps/api/.env for local development. Never commit real values.
NODE_ENV=development
HOST=127.0.0.1
PORT=4000
LOG_LEVEL=info
# Matches docker-compose.yml at the repository root.
DATABASE_URL=postgres://finken:finken@localhost:5433/finken
# Sign-in. dev: the API signs its own tokens (development and tests only).
# oidc: tokens from the sign-in provider, checked against its published keys.
AUTH_MODE=dev
AUTH_DEV_SECRET=change-me-to-a-long-random-development-only-secret
# AUTH_MODE=oidc
# AUTH_ISSUER=https://your-provider.example.com/
# AUTH_AUDIENCE=finken-api
# AUTH_JWKS_URL=https://your-provider.example.com/.well-known/jwks.json
