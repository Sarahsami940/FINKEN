{
  "name": "finken",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm run dev -w @finken/web",
    "dev:api": "npm run dev -w @finken/api",
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run db:migrate -w @finken/api",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "npm run build -w @finken/web && npm run build -w @finken/api",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
